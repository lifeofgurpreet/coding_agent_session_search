+fn hnsw_rs_basename_for(path: &Path) -> String {
+    let stem = path
+        .file_stem()
+        .and_then(|value| value.to_str())
+        .filter(|value| !value.is_empty())
+        .unwrap_or("ann");
+    format!("{stem}.hnsw-rs")
+}
+
+fn hnsw_rs_dump_files_present(parent: &Path, basename: &str) -> bool {
+    parent.join(format!("{basename}.hnsw.graph")).is_file()
+        && parent.join(format!("{basename}.hnsw.data")).is_file()
+}
